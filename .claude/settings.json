{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__Roblox_Studio__search_game_tree",
      "mcp__Roblox_Studio__inspect_instance",
      "mcp__Roblox_Studio__script_read",
      "mcp__Roblox_Studio__script_search",
      "mcp__Roblox_Studio__script_grep",
      "mcp__Roblox_Studio__get_studio_state",
      "mcp__Roblox_Studio__get_console_output",
      "mcp__Roblox_Studio__screen_capture",
      "mcp__Roblox_Studio__list_roblox_studios",
      "Bash(rojo build *)",
      "Bash(rojo sourcemap *)",
      "Bash(lune run *)",
      "Bash(selene *)",
      "Bash(stylua *)",
      "Bash(wally install)",
      "Bash(rokit install)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(python scripts/doctor.py *)",
      "PowerShell(rojo build *)",
      "PowerShell(rojo sourcemap *)",
      "PowerShell(lune run *)",
      "PowerShell(selene *)",
      "PowerShell(stylua *)",
      "PowerShell(wally install)",
      "PowerShell(rokit install)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(python scripts/doctor.py *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/kaggle.json)",
      "Read(~/.kaggle/**)"
    ],
    "ask": [
      "mcp__Roblox_Studio__execute_luau",
      "mcp__Roblox_Studio__multi_edit",
      "mcp__Roblox_Studio__start_stop_play",
      "mcp__Roblox_Studio__insert_asset",
      "mcp__Roblox_Studio__generate_*",
      "mcp__Roblox_Studio__upload_image",
      "mcp__Roblox_Studio__store_image"
    ]
  },
  "enabledMcpjsonServers": [
    "Roblox_Studio"
  ],
  "enabledPlugins": {
    "roblox-skills@roblox-skills": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "roblox-skills": {
      "source": {
        "source": "github",
        "repo": "EL4CTEO/roblox-skills",
        "ref": "v1.1.0"
      },
      "autoUpdate": false
    }
  }
}
