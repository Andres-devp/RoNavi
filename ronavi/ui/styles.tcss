/* RoNavi Studio · dark theme: fox orange ($primary), scarf red ($secondary), cream ($accent). */

Screen {
    background: $background;
}

.muted { color: $text-muted; }
.ok { color: $success; }
.bad { color: $error; }

.section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.subtitle {
    text-style: bold;
    color: $accent;
    margin: 1 0 0 0;
}

.hero-title {
    text-style: bold;
    color: $foreground;
}

.speech {
    color: $accent;
    text-style: italic;
    margin: 1 0;
}

.tip {
    color: $text-muted;
    margin-top: 1;
}

.card {
    background: $panel;
    border: round #3a3344;
    padding: 0 1;
    height: auto;
}

.button-row {
    height: auto;
    margin-top: 1;
}

.button-row Button {
    margin-right: 1;
    min-width: 12;
}

.inline-row {
    height: auto;
}

.inline-row Input, .inline-row Select {
    width: 1fr;
}

.inline-row Button {
    margin-left: 1;
    min-width: 10;
}

Button.small {
    min-width: 10;
}

.switch-row {
    height: auto;
    margin-top: 1;
}

.switch-row Switch {
    margin-right: 2;
}

/* ------------------------------------------------------------------ sidebar */

#main {
    height: 1fr;
}

#sidebar {
    width: 30;
    background: $surface;
    border-right: vkey #3a3344;
    padding: 1 1 0 1;
}

#brand {
    height: 6;
    margin-bottom: 1;
}

#brand-fox {
    width: 13;
}

#brand-name {
    padding: 1 0 0 1;
}

#nav {
    height: auto;
    background: $surface;
    border: none;
    padding: 0;
}

#nav:focus {
    border: none;
}

#nav > .option-list--option {
    padding: 0 1;
}

#env-pill {
    margin-top: 1;
    padding: 0 1;
    background: $panel;
    height: auto;
}

.nav-hint {
    dock: bottom;
    padding: 0 1;
}

/* ------------------------------------------------------------------ content */

#content {
    width: 1fr;
    height: 1fr;
}

Section, HomeSection, ProjectsSection, NewGameSection, SkillsSection, ToolsSection,
IntegrationsSection, SettingsSection {
    padding: 1 2;
    height: 1fr;
}

#home-hero {
    height: auto;
}

#home-fox {
    width: 26;
    height: 14;
    margin-right: 3;
}

#home-hero-text {
    height: auto;
    width: 1fr;
}

#home-env {
    min-height: 3;
}

#home-recent {
    min-height: 3;
}

#pj-body {
    height: 18;
}

#pj-table {
    width: 2fr;
    height: 100%;
}

#pj-side {
    width: 1fr;
    min-width: 34;
    height: 100%;
    margin-left: 1;
}

#sk-table, #tl-table {
    height: 22;
}

#key-table {
    height: 12;
}

.form {
    padding: 1 2;
    max-width: 100;
}

.form Label {
    margin-top: 1;
    color: $accent;
}

.form Checkbox {
    margin-top: 1;
    background: $panel;
    border: none;
}

#mcp-scope {
    width: 48;
    margin-top: 1;
}

#st-mode {
    background: $panel;
    border: none;
}

/* ------------------------------------------------------------------ welcome */

WelcomeScreen {
    align: center middle;
}

#welcome {
    width: auto;
    height: auto;
}

#welcome-row {
    width: auto;
    height: auto;
    padding: 1 3;
    background: $surface;
    border: round $primary;
}

#welcome-fox {
    width: 26;
    height: 14;
    margin-right: 4;
}

#welcome-text {
    width: 60;
    height: auto;
}

#wordmark {
    margin-top: 1;
}

.tagline {
    margin-top: 1;
    text-style: bold;
}

.hint {
    margin-top: 1;
}

#welcome-foot {
    width: auto;
    margin-top: 1;
}

/* ------------------------------------------------------------------ wizard */

#wizard {
    height: 1fr;
}

#wiz-side {
    width: 34;
    padding: 1 2;
    background: $surface;
    border-right: vkey #3a3344;
}

#wiz-fox {
    height: 14;
}

#wiz-main {
    padding: 1 2;
}

#wiz-steps {
    height: auto;
    max-height: 12;
    background: $panel;
    border: round #3a3344;
}

#wiz-steps > ListItem {
    padding: 0 1;
}

#wiz-detail-box {
    height: 1fr;
    min-height: 6;
    margin-top: 1;
    background: $panel;
    border: round #3a3344;
    padding: 0 1;
}

#wiz-optional {
    margin-top: 1;
    background: $background;
    border: none;
}

/* ------------------------------------------------------------------ dialogs */

ConfirmScreen, SecretScreen, TextScreen, TaskScreen {
    align: center middle;
    background: $background 70%;
}

.dialog {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

.dialog.wide {
    width: 120;
}

.dialog-title {
    text-style: bold;
    color: $primary;
}

.dialog-body {
    margin: 1 0;
}

.dialog-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.dialog-buttons Button {
    margin-left: 1;
}

.text-scroll {
    height: auto;
    max-height: 30;
    margin-top: 1;
}

.task-head {
    height: 7;
}

.task-fox {
    width: 13;
    margin-right: 2;
}

#task-spinner {
    height: 1;
    color: $primary;
}

#task-log {
    height: 22;
    background: $background;
    border: round #3a3344;
    margin-top: 1;
}
